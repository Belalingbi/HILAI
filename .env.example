# Configuration HILAI — Studio IA Modulaire « Human-in-the-Loop »
# Clé API Google Gemini (Optionnelle : HILAI bascule automatiquement en mode local autonome si absente)
GEMINI_API_KEY=votre_cle_api_gemini_ici

# Modèle Gemini recommandé (gemini-2.5-flash, gemini-1.5-pro, etc.)
GEMINI_MODEL=gemini-2.5-flash

# Paramètres de durcissement et sécurité
HILAI_SEC_STRICT=true
HILAI_SUBPROCESS_TIMEOUT=60
